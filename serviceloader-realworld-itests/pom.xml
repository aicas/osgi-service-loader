      <version>${junit.platform.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.opentest4j</groupId>
      <artifactId>opentest4j</artifactId>
      <version>1.3.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi</groupId>
      <artifactId>serviceloader-mediator</artifactId>
      <version>${revision}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi</groupId>
      <artifactId>serviceloader-weaver</artifactId>
